<Window
    x:Class="WPF.FicheClient"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="700"
    Height="500"
    MinWidth="700"
    MinHeight="500"
    mc:Ignorable="d">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.75*" />
            <ColumnDefinition Width="1.75*" />
            <ColumnDefinition Width="3.25*" />
            <ColumnDefinition Width="0.75*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*" />
            <RowDefinition Height="0.5*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="0.8*" />
            <RowDefinition Height="1.2*" />
            <RowDefinition Height="4*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>


        <Image
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Source="/Images/logoIntermarcher.png"
            Stretch="Fill" />
        <Image
            Grid.Column="4"
            Height="64"
            VerticalAlignment="Top"
            Source="/Images/indivisu.png"
            Stretch="Fill" />
        <Ellipse
            Grid.Column="4"
            Height="64"
            VerticalAlignment="Top"
            Stroke="Black" />

        <ComboBox
            x:Name="ComboBoxSelectionClient"
            Grid.Row="4"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Width="200"
            Height="30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <ComboBoxItem>Bernabet Gilbert</ComboBoxItem>
            <ComboBoxItem IsSelected="True">Selectionner un client</ComboBoxItem>
            <ComboBoxItem>Mohamed Ifaoui</ComboBoxItem>
        </ComboBox>
        <RadioButton
            x:Name="ButtonNouveauClient"
            Grid.Row="3"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Checked="ButtonNouveauClient_Checked"
            Content="Créer une nouvelle fiche client" />
        <Label
            x:Name="LabelOU"
            Grid.Row="3"
            Grid.RowSpan="2"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Width="28"
            Height="26"
            Margin="0,0,0,15"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Content="OU" />

        <Label
            Grid.Row="2"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Content="Client"
            FontSize="18"
            FontWeight="Bold" />

        <StackPanel
            Grid.Row="5"
            Grid.Column="1"
            Grid.ColumnSpan="2">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="TextBoxNom"
                    Grid.Column="0"
                    Text="Nom"
                    TextWrapping="Wrap" />

                <TextBox
                    x:Name="TextBoxPrenom"
                    Grid.Column="1"
                    Text="Prénom"
                    TextWrapping="Wrap" />
            </Grid>



            <TextBox
                x:Name="TextBoxAdresse"
                Grid.Column="0"
                Margin="0,5,0,0"
                Text="Adresse"
                TextWrapping="Wrap" />

            <TextBox
                x:Name="TextBoxVille"
                Grid.Column="0"
                Margin="0,5,0,0"
                Text="Ville"
                TextWrapping="Wrap" />

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="TextBoxCodePostal"
                    Grid.Column="0"
                    Margin="0,5,0,0"
                    Text="Code postal"
                    TextWrapping="Wrap" />
                <TextBox
                    x:Name="TextBoxPays"
                    Grid.Column="1"
                    Margin="0,5,0,0"
                    Text="Pays"
                    TextWrapping="Wrap" />

            </Grid>

            <TextBox
                x:Name="TextBoxMail"
                Grid.Column="0"
                Margin="0,5,0,0"
                Text="Mail"
                TextWrapping="Wrap" />
            <TextBox
                x:Name="TextBoxTelephone"
                Grid.Column="1"
                Margin="0,5,0,0"
                Text="Téléphone"
                TextWrapping="Wrap" />

            <RadioButton
                x:Name="ButtonEntreprise"
                Margin="0,15,0,0"
                Content="Entreprise" />
            <Button
                x:Name="ButtonValiderFicheClient"
                Grid.RowSpan="2"
                Width="70"
                Height="25"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Click="ButtonValiderFicheClient_Click"
                Content="Valider" />

        </StackPanel>
    </Grid>
</Window>
