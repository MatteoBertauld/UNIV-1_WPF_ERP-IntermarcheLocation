<Window
    x:Class="WPF.MainWindow_MenuEmploye"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MenuEmploye"
    Width="700"
    Height="500"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="0.6*" />
            <ColumnDefinition Width="0.4*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*" />
            <RowDefinition Height="2.5*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1.5*" />
        </Grid.RowDefinitions>

        <Image
            Grid.Row="1"
            Grid.Column="1"
            Source="/Images/logoIntermarcher.png"
            Stretch="Fill" />
        <Label
            Grid.Row="2"
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Content="Bienvenue : 'Nom Employé'"
            FontSize="14"
            FontWeight="Bold" />
        <Button
            x:Name="ButtonEffectuerReservation"
            Grid.Row="3"
            Grid.Column="1"
            Margin="5,5,5,5"
            Click="ButtonEffectuerReservation_Click"
            Content="Effectuer une Réservation" />
        <Button
            x:Name="ButtonVisualiserReservation"
            Grid.Row="4"
            Grid.Column="1"
            Margin="5,5,5,5"
            Click="ButtonVisualiserReservation_Click"
            Content="Visualiser les Réservations" />

        <Button
            Grid.Row="5"
            Grid.Column="1"
            Margin="5,5,5,5"
            Panel.ZIndex="-1"
            Content="Mon Compte" />

    </Grid>
</Window>
