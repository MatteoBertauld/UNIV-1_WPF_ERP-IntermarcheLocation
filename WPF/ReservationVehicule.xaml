<Window
    x:Class="WPF.ReservationVehicule"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ReservationVehicule"
    Width="700"
    Height="500"
    MinWidth="700"
    MinHeight="500"
    mc:Ignorable="d">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*" />
            <ColumnDefinition Width="0.4*" />
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="0.4*" />
            <ColumnDefinition Width="0.5*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="0.75*" />
            <ColumnDefinition Width="0.25*" />
            <ColumnDefinition Width="0.5*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>

            <RowDefinition Height="1.5*" />
            <RowDefinition Height="0.25*" />

            <RowDefinition Height="0.75*" />
            <RowDefinition Height="1.5*" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="0.8*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="0.25*" />
            <RowDefinition Height="0.75*" />
            <RowDefinition Height="0.25*" />
        </Grid.RowDefinitions>

        <Image
            Grid.RowSpan="2"
            Grid.ColumnSpan="3"
            Source="/Images/logoIntermarcher.png"
            Stretch="Fill" />
        <Image
            Grid.RowSpan="2"
            Grid.Column="8"
            Grid.ColumnSpan="2"
            Source="/Images/indivisu.png"
            Stretch="Fill" />
        <Ellipse
            Grid.RowSpan="2"
            Grid.Column="8"
            Grid.ColumnSpan="2"
            Stroke="Black" />
        <Label
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Grid.ColumnSpan="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Content="Choix des Véhicules"
            FontSize="18"
            FontWeight="Bold" />
        <Button
            x:Name="Valider_Critère"
            Grid.Row="8"
            Grid.Column="2"
            Click="Valider_Critère_Click"
            Content="Valider Critère" />
        <ListBox
            x:Name="ListeBoxVehiculeChoisit"
            Grid.Row="3"
            Grid.RowSpan="2"
            Grid.Column="5"
            Grid.ColumnSpan="4" />


        <ComboBox
            x:Name="ComboBoxCategorieVehicule"
            Grid.Row="5"
            Grid.Column="1"
            Grid.ColumnSpan="3"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Visibility="Hidden">
            <ComboBoxItem Content="Vehicule" IsSelected="True" />
            <ComboBoxItem Content="Renault" />
            <ComboBoxItem Content="Semi Remorque" />
        </ComboBox>

        <ComboBox
            x:Name="ComboBoxMagasin"
            Grid.Row="5"
            Grid.Column="1"
            Grid.ColumnSpan="3"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Visibility="Hidden">
            <ComboBoxItem Content="Magasin" IsSelected="True" />
            <ComboBoxItem Content="Annecy" />
            <ComboBoxItem Content="Grenoble" />
        </ComboBox>

        <Calendar
            x:Name="CalendarReservation"
            Grid.Row="4"
            Grid.RowSpan="4"
            Grid.Column="1"
            Grid.ColumnSpan="3"
            VerticalAlignment="Center"
            Visibility="Hidden" />


        <ListBox
            x:Name="ListeBoxVehiculeRecherche"
            Grid.Row="6"
            Grid.RowSpan="1"
            Grid.Column="5"
            Grid.ColumnSpan="4" />
        <Button
            x:Name="ButtonAjouterVehicule"
            Grid.Row="5"
            Grid.Column="6"
            Margin="10,0,10,0"
            VerticalContentAlignment="Center"
            Click="ButtonAjouterVehicule_Click"
            Content="+"
            FontSize="18" />

        <Label
            Grid.Row="2"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Content="Critère de recherche"
            FontSize="14"
            FontWeight="Bold" />

        <StackPanel
            Grid.Row="3"
            Grid.RowSpan="1"
            Grid.Column="1"
            Grid.ColumnSpan="3">

            <RadioButton
                x:Name="ButtonDateRéservation"
                Checked="ButtonDateRéservation_Checked"
                Content="Date de réservation"
                FontStretch="Normal" />

            <RadioButton
                x:Name="ButtonCategorieVehicule"
                Margin="0,5,0,0"
                Checked="ButtonCategorieVehicule_Checked"
                Content="Catégorie véhicule" />

            <RadioButton
                x:Name="ButtonMagasin"
                Margin="0,5,0,0"
                Checked="ButtonMagasin_Checked"
                Content="Magasin" />

        </StackPanel>

        <Button
            x:Name="ButtonFiltre"
            Grid.Row="2"
            Grid.Column="6"
            Margin="0,0,0,5"
            Click="ButtonFiltre_Click"
            Content="Filtre : Automatique" />
        <Button
            x:Name="ButtonSuivant"
            Grid.Row="8"
            Grid.Column="6"
            Click="ButtonSuivant_Click"
            Content="Suivant" />
    </Grid>
</Window>
