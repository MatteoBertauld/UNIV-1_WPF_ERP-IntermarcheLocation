<Window
    x:Class="WPF.VisualiserReservation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="VisualiserReservation"
    Width="700"
    Height="500"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="3*" />



            </Grid.RowDefinitions>
            <Image

            Source="/Images/logoIntermarcher.png"
            Stretch="Fill"
                            
            Grid.Row="0"
            Grid.RowSpan="1"
            Grid.Column="0"
                />
        <Image
            Width="70"
            Height="70"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Source="/Images/indivisu.png"
            Stretch="Fill"
            
            Grid.Row="0"
            Grid.Column="5"
            Grid.ColumnSpan="1"
            
            />
        <Ellipse
            Grid.Row="0"
            Grid.Column="5"
            Stroke="Black" 
            />
        <Label
            Width="197"
            Height="39"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Content="Visualiser Réservation"
            FontSize="18"
            FontWeight="Bold"
            
            Grid.Row="1"
            Grid.Column="2"
            Grid.ColumnSpan="2"
            
            />
        <CheckBox
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="Recherche par Nom"
            
            Grid.Row="2"
            Grid.Column="2"
            Grid.ColumnSpan="2"
            />
        <CheckBox

            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="rechereche par immatriculation de véhicule"
            
            Grid.Row="2"
            Grid.Column="4"
            Grid.ColumnSpan="2"
            />
        <TextBox
            Width="120"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text=""
            TextWrapping="Wrap" 
            
            Grid.Row="3"
            Grid.Column="3"
            Grid.ColumnSpan="1"
            
            />
        <ListBox x:Name="ListeBoxVehiculeRecherche"  
            Grid.Row="3"
            Grid.Column="1"
            Grid.ColumnSpan="4"
            Grid.RowSpan="3"
                 
                 />
        <Button x:Name="ButtonRetour" Content="Retour" HorizontalAlignment="Left"  VerticalAlignment="Top" Click="ButtonRetour_Click" 
            Grid.Row="0"
            Grid.Column="4"
            Grid.ColumnSpan="2"/>
    </Grid>
</Window>
