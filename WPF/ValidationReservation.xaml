<Window
    x:Class="WPF.ValidationReservation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ValidationReservation"
    Width="700"
    Height="500"
    mc:Ignorable="d">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="3*" />



        </Grid.RowDefinitions>


        <Image
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Source="/Images/logoIntermarcher.png"
            Stretch="Fill" />
        <Image
            Grid.Row="0"
            Grid.Column="5"
            Grid.ColumnSpan="1"
            Source="/Images/indivisu.png"
            Stretch="Fill" />

        <Ellipse
            Grid.Row="0"
            Grid.Column="5"
            Stroke="Black" />
        <Label
            Grid.Row="2"
            Grid.Column="2"
            Grid.ColumnSpan="1"
            Width="116"
            Height="48"
            HorizontalAlignment="Left"
            Content="Réservation"
            FontSize="18"
            FontWeight="Bold" />

        <ComboBox
            x:Name="ComboBoxAssurance"
            Grid.Row="3"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Width="200"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">

            <ComboBoxItem>Sans Assurance</ComboBoxItem>
            <ComboBoxItem IsSelected="True">Assurance</ComboBoxItem>
            <ComboBoxItem>Avec Assurance</ComboBoxItem>


        </ComboBox>
        <ComboBox
            x:Name="ComboBoxKilometre"
            Grid.Row="3"
            Grid.Column="4"
            Grid.ColumnSpan="2"
            Width="200"
            Height="30"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
            <ComboBoxItem>- 100km</ComboBoxItem>
            <ComboBoxItem IsSelected="True">Forfait Kilométrique</ComboBoxItem>
            <ComboBoxItem>Entre 100 et 250 km</ComboBoxItem>
            <ComboBoxItem>+ 250 km</ComboBoxItem>
        </ComboBox>
        <Button
            x:Name="ButtonValider"
            Grid.Row="5"
            Grid.Column="2"
            Grid.ColumnSpan="1"
            Width="70"
            Height="34"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Click="ButtonValider_Click"
            Content="Valider" />

        <Label
            Grid.Row="4"
            Grid.Column="2"
            Grid.ColumnSpan="2"
            Width="200"
            Height="36"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Content="Montant total : xx euros"
            FontSize="18" />
    </Grid>
</Window>
