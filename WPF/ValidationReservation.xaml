<Window
    x:Class="WPF.ValidationReservation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ValidationReservation"
    Width="700"
    Height="500"
    mc:Ignorable="d">
    <Grid>
        <Image
            Margin="0,1,510,409"
            Source="/Images/logoIntermarcher.png"
            Stretch="Fill" />
        <Image
            Margin="627,3,-2,420"
            Source="/Images/indivisu.png"
            Stretch="Fill" />
        <Ellipse
            Width="73"
            Height="67"
            Margin="627,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Stroke="Black" />
        <Label
            Width="116"
            Height="48"
            Margin="0,75,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Content="Réservation"
            FontSize="18"
            FontWeight="Bold" />

        <ComboBox
            x:Name="ComboBoxAssurance"
            Width="200"
            Height="30"
            Margin="80,161,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
            <ComboBoxItem>Sans Assurance</ComboBoxItem>
            <ComboBoxItem IsSelected="True">Assurance</ComboBoxItem>
            <ComboBoxItem>Avec Assurance</ComboBoxItem>
        </ComboBox>
        <ComboBox
            x:Name="ComboBoxKilometre"
            Width="200"
            Height="30"
            Margin="437,161,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
            <ComboBoxItem>- 100km</ComboBoxItem>
            <ComboBoxItem IsSelected="True">Forfait Kilométrique</ComboBoxItem>
            <ComboBoxItem>Entre 100 et 250 km</ComboBoxItem>
            <ComboBoxItem>+ 250 km</ComboBoxItem>
        </ComboBox>
        <Button
            x:Name="ButtonValider"
            Width="70"
            Height="34"
            Margin="0,404,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Click="ButtonValider_Click"
            Content="Valider" />
        <Label
            Width="200"
            Height="36"
            Margin="0,313,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Content="Montant total : xx euros"
            FontSize="18" />
    </Grid>
</Window>
