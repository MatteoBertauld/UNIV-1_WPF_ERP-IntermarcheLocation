<Window
    x:Class="WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Gestion des Réservations Intermarché"
    Width="700"
    Height="500"
    MinWidth="700"
    MinHeight="500"
    mc:Ignorable="d">
    <TabControl>

        <TabItem Header="ReservationVehicule">
            <Grid>
                <Grid x:Name="GridReservationVehicule" Visibility="Hidden">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.5*" />
                        <ColumnDefinition Width="0.4*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="0.4*" />
                        <ColumnDefinition Width="0.5*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="0.75*" />
                        <ColumnDefinition Width="0.25*" />
                        <ColumnDefinition Width="0.5*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="1.5*" />
                        <RowDefinition Height="0.25*" />

                        <RowDefinition Height="0.75*" />
                        <RowDefinition Height="1.5*" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="0.8*" />
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="0.25*" />
                        <RowDefinition Height="0.75*" />
                        <RowDefinition Height="0.25*" />
                    </Grid.RowDefinitions>

                    <Image
                        Grid.RowSpan="2"
                        Grid.ColumnSpan="3"
                        Source="/Images/logoIntermarcher.png"
                        Stretch="Fill" />
                    <Image
                        Grid.RowSpan="2"
                        Grid.Column="8"
                        Grid.ColumnSpan="2"
                        Source="/Images/indivisu.png"
                        Stretch="Fill" />
                    <Ellipse
                        Grid.RowSpan="2"
                        Grid.Column="8"
                        Grid.ColumnSpan="2"
                        Stroke="Black" />
                    <Label
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Content="Choix des Véhicules"
                        FontSize="18"
                        FontWeight="Bold" />
                    <Button
                        x:Name="Valider_Critère"
                        Grid.Row="8"
                        Grid.Column="2"
                        Click="Valider_Critère_Click"
                        Content="Valider Critère" />
                    <ListBox
                        x:Name="ListeBoxVehiculeChoisit"
                        Grid.Row="3"
                        Grid.RowSpan="2"
                        Grid.Column="5"
                        Grid.ColumnSpan="4" />


                    <ComboBox
                        x:Name="ComboBoxCategorieVehicule"
                        Grid.Row="5"
                        Grid.Column="1"
                        Grid.ColumnSpan="3"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Visibility="Hidden">
                        <ComboBoxItem Content="Vehicule" IsSelected="True" />
                        <ComboBoxItem Content="Renault" />
                        <ComboBoxItem Content="Semi Remorque" />
                    </ComboBox>

                    <ComboBox
                        x:Name="ComboBoxMagasin"
                        Grid.Row="5"
                        Grid.Column="1"
                        Grid.ColumnSpan="3"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Visibility="Hidden">
                        <ComboBoxItem Content="Magasin" IsSelected="True" />
                        <ComboBoxItem Content="Annecy" />
                        <ComboBoxItem Content="Grenoble" />
                    </ComboBox>

                    <Calendar
                        x:Name="CalendarReservation"
                        Grid.Row="4"
                        Grid.RowSpan="4"
                        Grid.Column="1"
                        Grid.ColumnSpan="3"
                        VerticalAlignment="Center"
                        Visibility="Hidden" />


                    <ListBox
                        x:Name="ListeBoxRechercheVehicule"
                        Grid.Row="6"
                        Grid.RowSpan="1"
                        Grid.Column="5"
                        Grid.ColumnSpan="4" />
                    <Button
                        x:Name="ButtonAjouterVehicule"
                        Grid.Row="5"
                        Grid.Column="6"
                        Margin="10,0,10,0"
                        VerticalContentAlignment="Center"
                        Click="ButtonAjouterVehicule_Click"
                        Content="+"
                        FontSize="18" />

                    <Label
                        Grid.Row="2"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Content="Critère de recherche"
                        FontSize="14"
                        FontWeight="Bold" />

                    <StackPanel
                        Grid.Row="3"
                        Grid.RowSpan="1"
                        Grid.Column="1"
                        Grid.ColumnSpan="3">

                        <RadioButton
                            x:Name="ButtonDateRéservation"
                            Checked="ButtonDateRéservation_Checked"
                            Content="Date de réservation"
                            FontStretch="Normal" />

                        <RadioButton
                            x:Name="ButtonCategorieVehicule"
                            Margin="0,5,0,0"
                            Checked="ButtonCategorieVehicule_Checked"
                            Content="Catégorie véhicule" />

                        <RadioButton
                            x:Name="ButtonMagasin"
                            Margin="0,5,0,0"
                            Checked="ButtonMagasin_Checked"
                            Content="Magasin" />

                    </StackPanel>

                    <Button
                        x:Name="ButtonFiltre"
                        Grid.Row="2"
                        Grid.Column="6"
                        Margin="0,0,0,5"
                        Click="ButtonFiltre_Click"
                        Content="Filtre : Automatique" />
                    <Button
                        x:Name="ButtonSuivant"
                        Grid.Row="8"
                        Grid.Column="6"
                        Click="ButtonSuivant_Click"
                        Content="Suivant" />
                </Grid>

                <Grid x:Name="GridValidationReservation" Visibility="Hidden">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="6*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="4*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.2*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1.5*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="3*" />



                    </Grid.RowDefinitions>


                    <Image
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Source="/Images/logoIntermarcher.png"
                        Stretch="Fill" />
                    <Image
                        Grid.Row="0"
                        Grid.Column="5"
                        Grid.ColumnSpan="1"
                        Source="/Images/indivisu.png"
                        Stretch="Fill" />

                    <Ellipse
                        Grid.Row="0"
                        Grid.Column="5"
                        Stroke="Black" />
                    <Label
                        Grid.Row="2"
                        Grid.Column="1"
                        Grid.ColumnSpan="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Réservation"
                        FontSize="18"
                        FontWeight="Bold" />

                    <ComboBox
                        x:Name="ComboBoxAssurance"
                        Grid.Row="3"
                        Grid.Column="1">

                        <ComboBoxItem>Sans Assurance</ComboBoxItem>
                        <ComboBoxItem IsSelected="True">Assurance</ComboBoxItem>
                        <ComboBoxItem>Avec Assurance</ComboBoxItem>
                    </ComboBox>

                    <ComboBox
                        x:Name="ComboBoxKilometre"
                        Grid.Row="3"
                        Grid.Column="3"
                        Grid.ColumnSpan="2">
                        <ComboBoxItem>- 100km</ComboBoxItem>
                        <ComboBoxItem IsSelected="True">Forfait Kilométrique</ComboBoxItem>
                        <ComboBoxItem>Entre 100 et 250 km</ComboBoxItem>
                        <ComboBoxItem>+ 250 km</ComboBoxItem>
                    </ComboBox>
                    <Button
                        x:Name="ButtonValider"
                        Grid.Row="6"
                        Grid.Column="2"
                        Grid.ColumnSpan="1"
                        Height="34"
                        VerticalAlignment="Top"
                        Click="ButtonValider_Click"
                        Content="Valider" />

                    <Label
                        Grid.Row="5"
                        Grid.Column="1"
                        Grid.ColumnSpan="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Montant total : xx euros"
                        FontSize="18" />

                </Grid>

                <Grid x:Name="GridFicheClient" Visibility="Visible">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.75*" />
                        <ColumnDefinition Width="1.75*" />
                        <ColumnDefinition Width="3.25*" />
                        <ColumnDefinition Width="0.75*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.5*" />
                        <RowDefinition Height="0.5*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="0.8*" />
                        <RowDefinition Height="1.2*" />
                        <RowDefinition Height="4*" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>

                    <Image
                        Grid.RowSpan="2"
                        Grid.ColumnSpan="2"
                        Source="/Images/logoIntermarcher.png"
                        Stretch="Fill" />
                    <Image
                        Grid.Column="4"
                        Height="64"
                        VerticalAlignment="Top"
                        Source="/Images/indivisu.png"
                        Stretch="Fill" />
                    <Ellipse
                        Grid.Column="4"
                        Height="64"
                        VerticalAlignment="Top"
                        Stroke="Black" />

                    <ComboBox
                        x:Name="ComboBoxSelectionClient"
                        Grid.Row="4"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Width="200"
                        Height="30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        SelectionChanged="ComboBoxSelectionClient_Selected" />
                    <CheckBox
                        x:Name="ButtonNouveauClient"
                        Grid.Row="3"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Checked="ButtonNouveauClient_Checked"
                        Content="Créer une nouvelle fiche client" />
                    <Label
                        x:Name="LabelOU"
                        Grid.Row="3"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Width="28"
                        Height="26"
                        Margin="0,0,0,15"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="OU" />

                    <Label
                        Grid.Row="2"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Content="Client"
                        FontSize="18"
                        FontWeight="Bold" />

                    <StackPanel
                        Grid.Row="5"
                        Grid.Column="1"
                        Grid.ColumnSpan="2">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Name="TextBoxNom"
                                Grid.Column="0"
                                Text="Nom"
                                TextWrapping="Wrap" />

                            <TextBox
                                x:Name="TextBoxPrenom"
                                Grid.Column="1"
                                Text="Prénom"
                                TextWrapping="Wrap" />
                        </Grid>

                        <TextBox
                            x:Name="TextBoxAdresse"
                            Grid.Column="0"
                            Margin="0,5,0,0"
                            Text="Adresse"
                            TextWrapping="Wrap" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Name="TextBoxVille"
                                Grid.Column="0"
                                Margin="0,5,0,0"
                                Text="Ville"
                                TextWrapping="Wrap" />

                            <TextBox
                                x:Name="TextBoxCodePostal"
                                Grid.Column="1"
                                Margin="0,5,0,0"
                                Text="Code postal"
                                TextWrapping="Wrap" />

                        </Grid>

                        <TextBox
                            x:Name="TextBoxMail"
                            Grid.Column="0"
                            Margin="0,5,0,0"
                            Text="Mail"
                            TextWrapping="Wrap" />
                        <TextBox
                            x:Name="TextBoxTelephone"
                            Grid.Column="1"
                            Margin="0,5,0,0"
                            Text="Téléphone"
                            TextWrapping="Wrap" />

                        <RadioButton
                            x:Name="ButtonEntreprise"
                            Margin="0,15,0,0"
                            Content="Entreprise" />
                        <Button
                            x:Name="ButtonValiderFicheClient"
                            Grid.RowSpan="2"
                            Width="70"
                            Height="25"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Click="ButtonValiderFicheClient_Click"
                            Content="Valider" />

                    </StackPanel>
                </Grid>
            </Grid>

        </TabItem>
        <TabItem Header="Visualiser Reservation">

            <Grid x:Name="GridVisualiserReservation" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="3*" />



                </Grid.RowDefinitions>
                <Image
                    Grid.Row="0"
                    Grid.RowSpan="1"
                    Grid.Column="0"
                    Source="/Images/logoIntermarcher.png"
                    Stretch="Fill" />
                <Image
                    Grid.Row="0"
                    Grid.Column="5"
                    Grid.ColumnSpan="1"
                    Width="70"
                    Height="70"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Source="/Images/indivisu.png"
                    Stretch="Fill" />
                <Ellipse
                    Grid.Row="0"
                    Grid.Column="5"
                    Stroke="Black" />
                <Label
                    Grid.Row="1"
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    Width="197"
                    Height="39"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Content="Visualiser Réservation"
                    FontSize="18"
                    FontWeight="Bold" />
                <CheckBox
                    Grid.Row="2"
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Content="Recherche par Nom" />
                <CheckBox
                    Grid.Row="2"
                    Grid.Column="4"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Content="rechereche par immatriculation de véhicule" />
                <TextBox
                    Grid.Row="3"
                    Grid.Column="3"
                    Grid.ColumnSpan="1"
                    Width="120"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Text=""
                    TextWrapping="Wrap" />
                <ListBox
                    x:Name="ListeBoxVisualiserVehicule"
                    Grid.Row="3"
                    Grid.RowSpan="3"
                    Grid.Column="1"
                    Grid.ColumnSpan="4" />
                <Button
                    x:Name="ButtonRetour"
                    Grid.Row="0"
                    Grid.Column="4"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Click="ButtonRetour_Click"
                    Content="Retour" />
            </Grid>
        </TabItem>
    </TabControl>
</Window>
